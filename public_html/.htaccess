Options -Indexes
ServerSignature Off

# ── XML sitemap — правильний Content-Type для Google Search Console
AddType application/xml .xml
<FilesMatch "sitemap.*\.xml$">
    Header set Content-Type "application/xml; charset=UTF-8"
</FilesMatch>

# ── robots.txt
<Files "robots.txt">
    Header set Content-Type "text/plain; charset=UTF-8"
</Files>

# ── HTTPS redirect
RewriteEngine On
RewriteRule ^blog/backlink-building-for-small-business-2026\.html$ /blog/backlink-building-for-small-business.html [R=301,L]
RewriteRule ^blog/cron-jobs-dlya-seo\.html$ /blog/cron-jobs-for-seo.html [R=301,L]
RewriteRule ^blog/on-page-seo-complete-guide-2026\.html$ /blog/on-page-seo-complete-guide.html [R=301,L]
RewriteRule ^blog/google-search-console-posibnyk\.html$ /blog/google-search-console-guide.html [R=301,L]
RewriteRule ^blog/core-web-vitals-2026\.html$ /blog/core-web-vitals.html [R=301,L]

RewriteRule ^blog/yak-pereviriti-indeksaciyu-saitu\.html$ /blog/how-to-check-site-indexing.html [R=301,L]

RewriteRule ^blog/best-google-indexing-tools-2026\.html$ /blog/best-google-indexing-tools.html [R=301,L]

RewriteRule ^blog/chomu-sait-ne-indeksuyetsya\.html$ /blog/why-is-site-not-indexed.html [R=301,L]

RewriteRule ^blog/seo-dlya-internet-magazynu\.html$ /blog/ecommerce-seo.html [R=301,L]

RewriteRule ^blog/wordpress-indeksaciya\.html$ /blog/wordpress-indexing.html [R=301,L]

RewriteRule ^blog/lokalne-seo\.html$ /blog/local-seo.html [R=301,L]

# ── Serve manual payment receipts securely from outside public_html
RewriteRule ^storage/receipts/([^/]+)$ api/billing/serve_receipt.php?file=$1 [L,QSA]

# ── 301 редіректи статичних сторінок
RewriteRule ^privacy-policy$ /privacy-policy.html [R=301,L]
RewriteRule ^privacy-policy/$ /privacy-policy.html [R=301,L]
RewriteRule ^terms-and-conditions/$ /terms.html [R=301,L]

# 301 /faqs → /faqs.html
RewriteRule ^faqs$ /faqs.html [R=301,L]
RewriteRule ^faqs/$ /faqs.html [R=301,L]

# 301 /pricing-ltd → /pricing-ltd.html
RewriteRule ^pricing-ltd$ /pricing-ltd.html [R=301,L]
RewriteRule ^pricing-ltd/$ /pricing-ltd.html [R=301,L]

# 301 redirects for new English-slug articles
RewriteRule ^on-page-seo-complete-guide-2026$ /blog/on-page-seo-complete-guide.html [R=301,L]
RewriteRule ^on-page-seo-complete-guide-2026/$ /blog/on-page-seo-complete-guide.html [R=301,L]
RewriteRule ^backlink-building-for-small-business-2026$ /blog/backlink-building-for-small-business-2026.html [R=301,L]
RewriteRule ^backlink-building-for-small-business-2026/$ /blog/backlink-building-for-small-business-2026.html [R=301,L]

# ── 301 редіректи старих дублікатів блогу
RewriteRule ^blog-indexation\.html$ /blog/how-to-speed-up-site-indexing-in-google.html [R=301,L]
RewriteRule ^blog/yak-pryskoriti-indeksaciyu-saitu-v-google\.html$ /blog/how-to-speed-up-site-indexing-in-google.html [R=301,L]
RewriteRule ^blog/yak-vybraty-drop-domen-dlya-pbn\.html$ /blog/how-to-choose-an-expired-domain-for-pbn.html [R=301,L]
RewriteRule ^blog-sitemap\.html$ /blog/shcho-take-sitemap-xml.html [R=301,L]

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Захищаємо .env
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

# ── Захищаємо конфігураційні PHP файли
<FilesMatch "^(config|db|helpers|middleware)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Захищаємо sql директорію
RewriteRule ^sql/ - [F,L]

# ── 404 сторінка
ErrorDocument 404 /404.html

# ── Кешування статичних файлів
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 month"
    ExpiresByType application/javascript  "access plus 1 month"
    ExpiresByType image/jpeg              "access plus 1 year"
    ExpiresByType image/png               "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 month"
    ExpiresByType application/xml         "access plus 1 day"
</IfModule>

# ── Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml
</IfModule>

# ── Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer-when-downgrade"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # ── Content Security Policy для лендінгу
    # unsafe-inline потрібен для inline <script> в статичних HTML сторінках
    # unsafe-eval потрібен для деяких аналітичних скриптів
    Header always set Content-Security-Policy "default-src 'self' https://*.paddle.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.paddle.com https://cdn.paddle.com https://public.profitwell.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.paddle.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: https://cdn.paddle.com https://*.paddle.com; connect-src 'self' https://indexfast.pro https://*.paddle.com https://checkout.paddle.com https://cdn.paddle.com https://public.profitwell.com; frame-src 'self' https://*.paddle.com https://checkout.paddle.com https://buy.paddle.com; frame-ancestors 'none'; form-action 'self' https://t.me; base-uri 'self'"
</IfModule>
