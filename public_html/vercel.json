        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://*.paddle.com https://*.paddleapi.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.paddle.com https://*.paddleapi.com https://cdn.paddle.com https://public.profitwell.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.paddle.com https://*.paddle.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: https://cdn.paddle.com https://*.paddle.com; connect-src 'self' https://indexfast.pp.ua https://*.paddle.com https://*.paddleapi.com https://checkout.paddle.com https://checkout-service.paddle.com https://cdn.paddle.com https://public.profitwell.com; frame-src 'self' https://*.paddle.com https://*.paddleapi.com https://checkout.paddle.com https://buy.paddle.com; frame-ancestors 'none'; form-action 'self' https://t.me; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer-when-downgrade"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://*.paddle.com https://*.paddleapi.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.paddle.com https://*.paddleapi.com https://cdn.paddle.com https://public.profitwell.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.paddle.com https://*.paddle.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: https://cdn.paddle.com https://*.paddle.com; connect-src 'self' https://indexfast.pp.ua https://*.indexfast.pp.ua https://*.paddle.com https://*.paddleapi.com https://checkout.paddle.com https://checkout-service.paddle.com https://cdn.paddle.com https://public.profitwell.com; frame-src 'self' https://*.paddle.com https://*.paddleapi.com https://checkout.paddle.com https://buy.paddle.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    }
  ],
