# URL API бекенду — без слешу в кінці
#
# Локальна розробка (OpenServer):
# VITE_API_URL=http://indexfast.local/api
#
# Продакшен (окремий домен для API):
# VITE_API_URL=https://api.indexfast.pp.ua/api
#
# Продакшен (API на тому самому домені):
# VITE_API_URL=https://indexfast.pp.ua/api
VITE_API_URL=http://indexfast.local/api
