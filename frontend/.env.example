# ══════════════════════════════════════════════
#  frontend/.env  (або frontend/.env.local)
#  Vite зчитує VITE_* змінні автоматично.
#  НЕ додавати в git — додай до .gitignore
# ══════════════════════════════════════════════

# ── URL бекенду
#
# Варіант A: фронт і бек на одному домені (стандартно)
#   VITE_API_URL не потрібен — за замовчуванням /api
#
# Варіант B: фронт і бек на РІЗНИХ доменах або хостингах
#   VITE_API_URL=https://api.indexfast.pro/api
#   або
#   VITE_API_URL=https://backend.indexfast.pro/api
#
# Важливо: на бекенді в .env пропиши FRONTEND_URL з адресою фронту:
#   FRONTEND_URL=https://app.indexfast.pro
#   (можна кілька через кому: https://app.indexfast.pro,https://indexfast.pro)

# VITE_API_URL=https://api.indexfast.pro/api


# ── Назва сайту (опціонально)
VITE_APP_NAME=IndexFast
