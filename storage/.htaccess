# ── storage/.htaccess
# Повна заборона прямого доступу до всієї папки storage через веб
# (файли видаються виключно через serve_receipt.php з авторизацією)

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (fallback)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Забороняємо виконання PHP-файлів на випадок якщо deny спрацює не так
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
