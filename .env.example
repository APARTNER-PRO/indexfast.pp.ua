# ══════════════════════════════════════════════
#  IndexFast — .env
#  Скопіюй у .env і заповни свої значення
#  НІКОЛИ не додавати .env в git!
# ══════════════════════════════════════════════

# ── App
APP_URL=https://indexfast.pp.ua     # URL де розміщений БЕКЕНД (API)
APP_ENV=production                  # production | development

# ── Frontend URL (може бути інший домен ніж бекенд)
# Якщо frontend і backend на одному домені — залиш такий самий як APP_URL
# Кілька доменів через кому: https://indexfast.pp.ua,https://app.indexfast.com
FRONTEND_URL=https://indexfast.pp.ua

# ── Database (MySQL 8.0+)
# Hostinger: Settings → Databases → знайди назву, юзера і пароль
DB_HOST=localhost
DB_PORT=3306
DB_NAME=indexfast_db
DB_USER=indexfast_user
DB_PASS=STRONG_PASSWORD_HERE

# ── JWT
# Генерація: openssl rand -hex 32
# Або: https://generate-secret.vercel.app/32
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM_STRING_HERE

# ── Google OAuth 2.0 (для кнопки "Увійти через Google")
# 1. https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID → Web application
# 3. Authorized redirect URIs: https://indexfast.pp.ua/api/auth/google/callback.php
# Якщо не потрібен Google OAuth — залиш порожнім
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SMTP Email (для підтвердження email і скидання пароля)
# Gmail: Google Account → Security → App Passwords → Generate
# Або використай сервіс: Brevo, Mailgun, SendGrid (є безкоштовні плани)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx     # 16-символьний App Password

MAIL_FROM=noreply@indexfast.pp.ua
MAIL_FROM_NAME=IndexFast

# ── Моніторинг воркера (опціонально)
# Якщо заповнено — health.php надсилатиме Telegram алерти при збоях
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Діагностика БД (db_check.php)
# Після деплою відкрий: https://indexfast.pp.ua/api/db_check.php?token=ТУТ_СЕКРЕТ
# Після перевірки — видали db_check.php або залиш порожнім
DB_CHECK_TOKEN=

# ── Адмінка
ADMIN_PASSWORD=change_me_strong_password_here
ADMIN_IPS=                        # Ваш IP через кому. Пусто = без IP фільтру

# ── Внутрішній API (Воркер)
WORKER_KEY=indexfast_secret_key_2024   # Ключ для доступу воркера до API

# ── Paddle білінг
PADDLE_WEBHOOK_SECRET=   # Секрет з Paddle Dashboard → Notifications

# ── Оплата: Stripe
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Оплата: LiqPay
LIQPAY_ENABLED=false
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# ── Оплата: Банківський переказ (ручний)
MANUAL_TRANSFER_ENABLED=false
MANUAL_TRANSFER_CARD_NUMBER=
MANUAL_TRANSFER_IBAN=
MANUAL_TRANSFER_RECIPIENT=IndexFast
MANUAL_TRANSFER_BANK=

# ── Ціни тарифів (UAH)
PRICE_START_MONTH=0
PRICE_START_YEAR=0
PRICE_START_3_YEARS=0

# PRO: місяць 499, рік (як 10 міс) ~4990, 3 роки (як 2.5 роки) ~14990
PRICE_PRO_MONTH=499
PRICE_PRO_YEAR=4990
PRICE_PRO_3_YEARS=14990

# AGENCY: місяць 2999, рік (як 10 міс) ~29990, 3 роки (як 2.5 роки) ~89990
PRICE_AGENCY_MONTH=2999
PRICE_AGENCY_YEAR=29990
PRICE_AGENCY_3_YEARS=89990
